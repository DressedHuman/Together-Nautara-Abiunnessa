# Copy to .env, then: php artisan key:generate
APP_NAME=Together
APP_ENV=local
APP_KEY=
# true only on your own machine. Production must use APP_ENV=production, APP_DEBUG=false
APP_DEBUG=true
APP_URL=http://localhost:8000
# Where the React app lives (used in emails). Same as APP_URL when Laravel serves it.
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Development: SQLite (database/database.sqlite). cPanel: MySQL/MariaDB.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=cpaneluser_together
# DB_USERNAME=cpaneluser_together
# DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Development: emails (verification codes!) are written to storage/logs/mail.log.
MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail
# Production (Brevo SMTP or your cPanel mailbox):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@together.nautaraablhs.edu.bd"
MAIL_FROM_NAME="Together"

# Comma-separated emails that become committee members when they verify.
COMMITTEE_EMAILS=

# Only when the React app runs on another origin (e.g. Vite dev server, Vercel).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to * (or proxy IPs) only if the site is behind Cloudflare or another proxy.
TRUSTED_PROXIES=
