# Copy to backend/.env and fill in. Never commit the real .env.

# --- Core ---------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# True only on your own machine. Production must run with DEBUG=False.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Where the React app lives (used in emails)
FRONTEND_URL=http://localhost:5173
# Only needed when the frontend is on another origin (e.g. Vercel)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Number of reverse proxies in front of Django (Render/Railway: 1), so rate limits see the real client IP
NUM_PROXIES=0
# SQLITE_PATH=/var/data/db.sqlite3   # put the database on a persistent disk in production

# --- Email (Brevo SMTP). Leave EMAIL_BACKEND unset in development to print emails to the console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Together <no-reply@together.nautaraablhs.edu.bd>

# --- Media (Cloudinary). Leave empty to store photos in backend/media/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
